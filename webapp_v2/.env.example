# OCR CCCD chạy ngay trên máy, không cần khóa API (cài dữ liệu: python -m tools.setup_ocr)
# TESSDATA_DIR=data/tessdata

# Origin được phép gọi API từ trình duyệt (CORS), phân tách bằng dấu phẩy.
# Mặc định: http://localhost:8002,http://127.0.0.1:8002
# CORS_ORIGINS=https://hoso.example.com

# Giới hạn số lần gọi mỗi phút từ một địa chỉ IP (0 = tắt)
# RATE_LIMIT_GENERATE=30
# RATE_LIMIT_OCR=20
# RATE_LIMIT_INQUIRY=5

# Mức ghi log: DEBUG, INFO, WARNING, ERROR
# LOG_LEVEL=INFO
