{
  "id": "thay-doi-noi-dung-dkkd",
  "name": "Thay đổi nội dung ĐKKD",
  "display_name": "Thay đổi nội dung ĐKKD",
  "category": "Thay đổi ĐKKD",
  "description": "Một bộ hồ sơ cho nhiều nội dung thay đổi đăng ký doanh nghiệp cùng lúc (tên, địa chỉ, thành viên, vốn, ngành nghề, thuế, chủ sở hữu hưởng lợi), cho TNHH 1 TV, TNHH 2 TV và Cổ phần",
  "has_nganh": true,
  "steps": [
    {
      "id": "company",
      "title": "Thông tin doanh nghiệp",
      "fields": [
        {
          "key": "ten_cong_ty_vn",
          "label": "Tên công ty",
          "type": "text",
          "required": true
        },
        {
          "key": "ma_so_thue",
          "label": "Mã số thuế",
          "type": "mst_lookup",
          "required": true
        },
        {
          "key": "loai_hinh",
          "label": "Loại hình doanh nghiệp",
          "type": "select",
          "required": true,
          "default": "tnhh_1tv",
          "options": [
            {
              "value": "tnhh_1tv",
              "label": "Công ty TNHH một thành viên"
            },
            {
              "value": "tnhh_2tv",
              "label": "Công ty TNHH hai thành viên trở lên"
            },
            {
              "value": "cp",
              "label": "Công ty cổ phần"
            }
          ]
        },
        {
          "key": "tinh_dang_ky",
          "label": "Tỉnh/Thành phố nơi đăng ký",
          "type": "select",
          "options_source": "tinh_thanh",
          "default": "Hà Nội",
          "required": true
        },
        {
          "key": "sdt_cong_ty",
          "label": "Điện thoại công ty",
          "type": "phone"
        },
        {
          "key": "email_cong_ty",
          "label": "Email công ty",
          "type": "email"
        }
      ]
    },
    {
      "id": "sections",
      "title": "Các nội dung cần thay đổi",
      "fields": [
        {
          "key": "dkkd_selected",
          "label": "Chọn các nội dung thay đổi (có thể chọn nhiều)",
          "type": "checkbox_group",
          "required": true,
          "options": [
            {
              "value": "A1",
              "label": "A1: Đổi tên doanh nghiệp"
            },
            {
              "value": "A2",
              "label": "A2: Đổi địa chỉ trụ sở chính"
            },
            {
              "value": "A3",
              "label": "A3: Thay đổi thành viên (chỉ TNHH 2 TV)"
            },
            {
              "value": "A4",
              "label": "A4: Thay đổi vốn điều lệ"
            },
            {
              "value": "A5",
              "label": "A5: Thay đổi ngành, nghề kinh doanh (bổ sung / bỏ ngành)"
            },
            {
              "value": "A6",
              "label": "A6: Thay đổi thông tin đăng ký thuế"
            },
            {
              "value": "A7",
              "label": "A7: Thay đổi chủ sở hữu hưởng lợi"
            },
            {
              "value": "A8",
              "label": "A8: Đổi người đại diện theo pháp luật"
            }
          ]
        }
      ]
    },
    {
      "id": "a1",
      "title": "A1. Tên doanh nghiệp sau khi thay đổi",
      "show_if": {
        "field": "dkkd_selected",
        "contains": "A1"
      },
      "fields": [
        {
          "key": "ten_moi_vn",
          "label": "Tên tiếng Việt",
          "type": "text",
          "required": true
        },
        {
          "key": "ten_moi_nn",
          "label": "Tên tiếng nước ngoài",
          "type": "text"
        },
        {
          "key": "ten_moi_viet_tat",
          "label": "Tên viết tắt",
          "type": "text"
        }
      ]
    },
    {
      "id": "a2",
      "title": "A2. Địa chỉ trụ sở chính sau khi thay đổi",
      "show_if": {
        "field": "dkkd_selected",
        "contains": "A2"
      },
      "description": "Chuyển trụ sở sang tỉnh/thành khác thì nộp hồ sơ ở tỉnh mới: chọn lại 'Tỉnh/Thành phố nơi đăng ký' ở bước đầu.",
      "fields": [
        {
          "key": "dia_chi_moi_so_nha",
          "label": "Số nhà, đường",
          "type": "text",
          "required": true
        },
        {
          "key": "dia_chi_moi_xa_phuong",
          "label": "Xã/Phường/Đặc khu",
          "type": "text",
          "required": true
        },
        {
          "key": "dia_chi_moi_tinh_thanh",
          "label": "Tỉnh/Thành phố",
          "type": "text",
          "required": true
        }
      ]
    },
    {
      "id": "a4",
      "title": "A4. Vốn điều lệ",
      "show_if": {
        "field": "dkkd_selected",
        "contains": "A4"
      },
      "fields": [
        {
          "key": "hinh_thuc_thay_doi_von",
          "label": "Hình thức",
          "type": "select",
          "required": true,
          "default": "tang",
          "options": [
            {
              "value": "tang",
              "label": "Tăng vốn điều lệ"
            },
            {
              "value": "giam",
              "label": "Giảm vốn điều lệ"
            }
          ]
        },
        {
          "key": "von_cu_so",
          "label": "Vốn điều lệ đã đăng ký (VNĐ)",
          "type": "money",
          "required": true
        },
        {
          "key": "von_dieu_le_so",
          "label": "Vốn điều lệ sau khi thay đổi (VNĐ)",
          "type": "money",
          "required": true
        },
        {
          "key": "ngay_thay_doi_von",
          "label": "Thời điểm thay đổi vốn",
          "type": "date"
        },
        {
          "key": "menh_gia_co_phan",
          "label": "Mệnh giá cổ phần (VNĐ)",
          "type": "text",
          "default": "10.000",
          "show_if": {
            "field": "loai_hinh",
            "equals": "cp"
          }
        }
      ]
    },
    {
      "id": "tv_cu",
      "title": "Thành viên TRƯỚC khi thay đổi (dự họp Hội đồng thành viên)",
      "show_if": {
        "all": [
          {
            "field": "loai_hinh",
            "equals": "tnhh_2tv"
          },
          {
            "field": "dkkd_selected",
            "contains": "A3"
          }
        ]
      },
      "description": "Khi thay đổi thành viên, cuộc họp Hội đồng thành viên do các thành viên hiện tại (trước khi thay đổi) dự họp và biểu quyết.",
      "fields": [
        {
          "key": "tv_cu",
          "label": "Thành viên hiện tại",
          "type": "list",
          "min": 2,
          "item": [
            {
              "key": "ho_ten",
              "label": "Họ và tên",
              "type": "text",
              "required": true
            },
            {
              "key": "gioi_tinh",
              "label": "Giới tính",
              "type": "select",
              "default": "Nam",
              "options": [
                {
                  "value": "Nam",
                  "label": "Nam"
                },
                {
                  "value": "Nữ",
                  "label": "Nữ"
                }
              ]
            },
            {
              "key": "ngay_sinh",
              "label": "Ngày sinh",
              "type": "date"
            },
            {
              "key": "so_cccd",
              "label": "Số CCCD",
              "type": "cccd",
              "required": true
            }
          ],
          "rules": [
            {
              "unique": "so_cccd"
            }
          ]
        }
      ]
    },
    {
      "id": "members",
      "title": "Thành viên / cổ đông / chủ sở hữu hưởng lợi",
      "show_if": {
        "any": [
          {
            "field": "loai_hinh",
            "in": [
              "tnhh_2tv",
              "cp"
            ]
          },
          {
            "field": "dkkd_selected",
            "contains": "A7"
          }
        ]
      },
      "description": "TNHH 2 TV: thành viên sau khi thay đổi (dự họp Hội đồng thành viên, Danh sách thành viên). Cổ phần: cổ đông dự họp Đại hội đồng cổ đông. Khi chọn A7: danh sách này cũng là danh sách chủ sở hữu hưởng lợi.",
      "fields": [
        {
          "key": "thanh_vien",
          "label": "Thành viên / cổ đông / chủ sở hữu hưởng lợi",
          "type": "person_list",
          "min": 2,
          "ocr": true,
          "extra_fields": [
            {
              "key": "von_gop",
              "label": "Vốn góp (VNĐ)",
              "type": "money",
              "required": true
            },
            {
              "key": "ty_le",
              "label": "Tỷ lệ (%)",
              "type": "number",
              "required": true
            }
          ]
        }
      ]
    },
    {
      "id": "a5",
      "title": "A5. Ngành, nghề bỏ khỏi danh sách đã đăng ký",
      "show_if": {
        "field": "dkkd_selected",
        "contains": "A5"
      },
      "description": "Ngành bổ sung chọn ở bước 'Ngành nghề kinh doanh'. Ở đây kê các ngành cần bỏ (nếu có).",
      "fields": [
        {
          "key": "nganh_bo",
          "label": "Ngành bỏ",
          "type": "list",
          "item": [
            {
              "key": "ma",
              "label": "Mã ngành",
              "type": "text",
              "required": true
            },
            {
              "key": "ten",
              "label": "Tên ngành",
              "type": "text",
              "required": true
            }
          ]
        }
      ]
    },
    {
      "id": "a6",
      "title": "A6. Thông tin đăng ký thuế",
      "show_if": {
        "field": "dkkd_selected",
        "contains": "A6"
      },
      "fields": [
        {
          "key": "ktt",
          "label": "Kế toán trưởng / Phụ trách kế toán",
          "type": "person",
          "ocr": true
        },
        {
          "key": "ktt_sdt",
          "label": "Điện thoại kế toán trưởng",
          "type": "phone"
        },
        {
          "key": "dia_chi_thue_so_nha",
          "label": "Địa chỉ nhận thông báo thuế: số nhà, đường",
          "type": "text",
          "help": "Để trống thì dùng địa chỉ trụ sở (mới, nếu có đổi địa chỉ)."
        },
        {
          "key": "dia_chi_thue_xa_phuong",
          "label": "Địa chỉ nhận thông báo thuế: xã/phường",
          "type": "text"
        },
        {
          "key": "dia_chi_thue_tinh_thanh",
          "label": "Địa chỉ nhận thông báo thuế: tỉnh/thành phố",
          "type": "text"
        }
      ]
    },
    {
      "id": "a8",
      "title": "A8. Người đại diện theo pháp luật trước khi thay đổi",
      "show_if": {
        "field": "dkkd_selected",
        "contains": "A8"
      },
      "description": "Người đại diện mới nhập ở bước cuối (người ký hồ sơ).",
      "fields": [
        {
          "key": "ddpl_cu",
          "label": "Người đại diện theo pháp luật cũ",
          "type": "person",
          "ocr": true,
          "required": true
        }
      ]
    },
    {
      "id": "chu_tich",
      "title": "Người ký Quyết định / chủ tọa cuộc họp",
      "description": "TNHH 1 TV: Chủ sở hữu. TNHH 2 TV: Chủ tịch Hội đồng thành viên. Cổ phần: Chủ tịch Hội đồng quản trị.",
      "fields": [
        {
          "key": "chu_tich",
          "label": "Chủ sở hữu / Chủ tịch Hội đồng thành viên / Chủ tịch Hội đồng quản trị",
          "type": "person",
          "ocr": true,
          "required": true
        }
      ]
    },
    {
      "id": "ddpl",
      "title": "Người đại diện theo pháp luật",
      "fields": [
        {
          "key": "ddpl",
          "label": "Thông tin người ĐDPL",
          "type": "person",
          "ocr": true,
          "required": true
        }
      ]
    }
  ],
  "documents": [
    {
      "file": "01. Thông báo bổ sung cập nhật.docx",
      "when": {
        "any": [
          {
            "field": "dkkd_selected",
            "contains": "A1"
          },
          {
            "field": "dkkd_selected",
            "contains": "A2"
          },
          {
            "field": "dkkd_selected",
            "contains": "A3"
          },
          {
            "field": "dkkd_selected",
            "contains": "A4"
          },
          {
            "field": "dkkd_selected",
            "contains": "A5"
          },
          {
            "field": "dkkd_selected",
            "contains": "A6"
          },
          {
            "field": "dkkd_selected",
            "contains": "A7"
          }
        ]
      }
    },
    {
      "file": "02. Giấy ủy quyền.docx"
    },
    {
      "file": "03. Quyết định.docx"
    },
    {
      "file": "04. Biên bản họp.docx",
      "when": {
        "field": "loai_hinh",
        "in": [
          "tnhh_2tv",
          "cp"
        ]
      }
    },
    {
      "file": "05. Danh sách thành viên.docx",
      "when": {
        "all": [
          {
            "field": "loai_hinh",
            "equals": "tnhh_2tv"
          },
          {
            "any": [
              {
                "field": "dkkd_selected",
                "contains": "A3"
              },
              {
                "field": "dkkd_selected",
                "contains": "A4"
              }
            ]
          }
        ]
      },
      "post": [
        "fill_member_table"
      ]
    },
    {
      "file": "06. Danh sách chủ sở hữu hưởng lợi.docx",
      "when": {
        "field": "dkkd_selected",
        "contains": "A7"
      },
      "post": [
        "fill_cshhl_table"
      ]
    },
    {
      "file": "07. Thông báo thay đổi người đại diện theo pháp luật.docx",
      "when": {
        "field": "dkkd_selected",
        "contains": "A8"
      }
    }
  ]
}
