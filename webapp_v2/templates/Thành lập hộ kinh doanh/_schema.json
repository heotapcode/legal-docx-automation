        },
        {
          "key": "thue_dia_chi_xa_phuong",
          "label": "Địa chỉ nhận thông báo thuế: Xã/Phường/Đặc khu",
          "type": "text"
        },
        {
          "key": "thue_dia_chi_tinh_thanh",
          "label": "Địa chỉ nhận thông báo thuế: Tỉnh/Thành phố",
          "type": "text"
        }
      ]
    }
  ],
