  "description": "Hồ sơ đăng ký hộ kinh doanh do một cá nhân thành lập: Giấy đề nghị đăng ký hộ kinh doanh, Giấy ủy quyền",
  "has_nganh": true,
  "steps": [
    {
      "id": "chu_ho",
      "title": "Chủ hộ kinh doanh",
      "fields": [
        {
          "key": "chu_ho",
          "label": "Chủ hộ kinh doanh (địa chỉ: địa chỉ liên hệ, in ở Giấy ủy quyền)",
          "type": "person",
          "ocr": true,
          "required": true
        },
        {
          "key": "chu_ho_sdt",
          "label": "Điện thoại của chủ hộ (nếu có)",
