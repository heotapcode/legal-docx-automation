        {
          "key": "pp_thue_gtgt",
          "label": "Phương pháp tính thuế GTGT",
          "type": "select",
          "default": "ke_khai",
          "options": [
            {
              "value": "ke_khai",
              "label": "Phương pháp kê khai"
            },
            {
              "value": "khoan",
              "label": "Phương pháp khoán"
            }
          ]
        },
        {
          "key": "ngay_bat_dau_hd",
          "label": "Ngày bắt đầu hoạt động (để trống nếu bắt đầu từ ngày được cấp Giấy chứng nhận)",
          "type": "date"
        },
        {
          "key": "thue_dia_chi_so_nha",
          "label": "Địa chỉ nhận thông báo thuế (chỉ khi khác trụ sở): Số nhà, đường",
