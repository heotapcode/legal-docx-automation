{
  "id": "chuyen-nhuong-cong-ty-tnhh-2-tv",
  "name": "Chuyển nhượng Công ty TNHH 2 TV",
  "display_name": "Chuyển nhượng Công ty TNHH 2 TV",
  "category": "Chuyển nhượng & Chuyển đổi",
  "description": "Bộ hồ sơ chuyển nhượng phần vốn góp giữa các thành viên Công ty TNHH 2 thành viên",
  "has_nganh": false,
  "steps": [
    {
      "id": "company",
      "title": "Thông tin Doanh nghiệp",
      "fields": [
        {
          "key": "ten_cong_ty_vn",
          "label": "Tên công ty",
          "type": "text",
          "required": true
        },
        {
          "key": "ma_so_thue",
          "label": "Mã số thuế",
          "type": "mst_lookup",
          "required": true
        },
        {
          "key": "tinh_dang_ky",
          "label": "Tỉnh/Thành phố nơi đăng ký",
          "type": "select",
          "options_source": "tinh_thanh",
          "default": "Hà Nội",
          "required": true
        }
      ]
    },
    {
      "id": "ddpl_cu",
      "title": "Người đại diện theo pháp luật CŨ",
      "fields": [
        {
          "key": "ddpl_cu",
          "label": "ĐDPL cũ",
          "type": "person",
          "ocr": true,
          "required": true
        }
      ]
    },
    {
      "id": "tv_cu",
      "title": "Thành viên CŨ (bên chuyển nhượng)",
      "fields": [
        {
          "key": "tv_cu",
          "label": "Thành viên cũ",
          "type": "list",
          "min": 2,
          "help": "Danh sách thành viên trước khi chuyển nhượng. Bên chuyển nhượng ở các giao dịch được chọn từ danh sách này.",
          "item": [
            {
              "key": "ho_ten",
              "label": "Họ và tên",
              "type": "text",
              "required": true
            },
            {
              "key": "gioi_tinh",
              "label": "Giới tính",
              "type": "select",
              "default": "Nam",
              "options": [
                {
                  "value": "Nam",
                  "label": "Nam"
                },
                {
                  "value": "Nữ",
                  "label": "Nữ"
                }
              ]
            },
            {
              "key": "ngay_sinh",
              "label": "Ngày sinh",
              "type": "date"
            },
            {
              "key": "so_cccd",
              "label": "Số CCCD",
              "type": "cccd",
              "required": true
            },
            {
              "key": "dia_chi_day_du",
              "label": "Địa chỉ thường trú đầy đủ",
              "type": "text",
              "placeholder": "Số nhà, Phường/Xã, Tỉnh/Thành phố",
              "required": true
            }
          ],
          "rules": [
            {
              "unique": "so_cccd"
            }
          ]
        }
      ]
    },
    {
      "id": "ddpl_moi",
      "title": "Người đại diện theo pháp luật MỚI",
      "fields": [
        {
          "key": "ddpl",
          "label": "ĐDPL mới (giữ nguyên nếu không đổi)",
          "type": "person",
          "ocr": true,
          "required": true
        }
      ]
    },
    {
      "id": "members",
      "title": "Danh sách thành viên MỚI sau chuyển nhượng",
      "fields": [
        {
          "key": "thanh_vien",
          "label": "Thành viên sau chuyển nhượng",
          "type": "list",
          "min": 2,
          "item": [
            {
              "key": "ho_ten",
              "label": "Họ và tên",
              "type": "text",
              "required": true
            },
            {
              "key": "gioi_tinh",
              "label": "Giới tính",
              "type": "select",
              "default": "Nam",
              "options": [
                {
                  "value": "Nam",
                  "label": "Nam"
                },
                {
                  "value": "Nữ",
                  "label": "Nữ"
                }
              ]
            },
            {
              "key": "ngay_sinh",
              "label": "Ngày sinh",
              "type": "date"
            },
            {
              "key": "so_cccd",
              "label": "Số CCCD",
              "type": "cccd"
            },
            {
              "key": "dia_chi_so_nha",
              "label": "Số nhà, đường",
              "type": "text"
            },
            {
              "key": "dia_chi_xa_phuong",
              "label": "Xã/Phường",
              "type": "text"
            },
            {
              "key": "dia_chi_tinh_thanh",
              "label": "Tỉnh/Thành phố",
              "type": "text"
            },
            {
              "key": "von_gop",
              "label": "Vốn góp (VNĐ)",
              "type": "money",
              "required": true
            },
            {
              "key": "ty_le",
              "label": "Tỷ lệ (%)",
              "type": "number",
              "required": true
            }
          ],
          "auto_ratio": {
            "part": "von_gop",
            "total": "von_dieu_le_so",
            "target": "ty_le"
          }
        }
      ]
    },
    {
      "id": "transfers",
      "title": "Thông tin Hợp đồng chuyển nhượng",
      "fields": [
        {
          "key": "chuyen_nhuong",
          "label": "Giao dịch chuyển nhượng",
          "type": "list",
          "min": 1,
          "item": [
            {
              "key": "ben_a",
              "label": "Bên chuyển nhượng (Bên A)",
              "type": "select",
              "options_from": "tv_cu",
              "required": true
            },
            {
              "key": "ben_b",
              "label": "Bên nhận chuyển nhượng (Bên B)",
              "type": "select",
              "options_from": "thanh_vien",
              "required": true
            },
            {
              "key": "gia_tri_so",
              "label": "Giá trị phần vốn chuyển nhượng (VNĐ)",
              "type": "money",
              "required": true
            },
            {
              "key": "ty_le",
              "label": "Tỷ lệ phần vốn chuyển nhượng (%)",
              "type": "percent",
              "validate": {
                "min": 0,
                "max": 100
              }
            }
          ]
        }
      ]
    }
  ],
  "documents": [
    {
      "file": "01. Thông báo bổ sung cập nhật.docx"
    },
    {
      "file": "02. Thông báo thay đổi người đại diện theo pháp luật.docx",
      "when": {
        "field": "ddpl_changed",
        "equals": true
      }
    },
    {
      "file": "03. Danh sách thành viên.docx",
      "post": [
        "fill_member_table"
      ]
    },
    {
      "file": "04. Danh sách chủ sở hữu hưởng lợi.docx",
      "post": [
        "fill_cshhl_table"
      ]
    },
    {
      "file": "05. Giấy ủy quyền.docx"
    },
    {
      "file": "06. Hợp đồng chuyển nhượng.docx",
      "repeat_for": "chuyen_nhuong",
      "repeat_with": "giao_dich_chuyen_nhuong"
    },
    {
      "file": "07. Biên bản thanh lý.docx",
      "repeat_for": "chuyen_nhuong",
      "repeat_with": "giao_dich_chuyen_nhuong"
    },
    {
      "file": "08. Quyết định.docx",
      "when": {
        "field": "ddpl_changed",
        "equals": true
      }
    },
    {
      "file": "09. Xác nhận góp vốn 1.docx",
      "repeat_for": "tv_moi",
      "repeat_with": "xac_nhan_gop_von"
    },
    {
      "file": "10. Xác nhận góp vốn 2.docx",
      "when": {
        "field": "tv_moi",
        "not_empty": false
      }
    }
  ]
}
