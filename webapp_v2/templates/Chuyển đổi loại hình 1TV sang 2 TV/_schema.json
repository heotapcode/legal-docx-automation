{
  "id": "chuyen-doi-loai-hinh-1tv-sang-2-tv",
  "name": "Chuyển đổi loại hình 1TV sang 2 TV",
  "display_name": "Chuyển đổi loại hình 1TV sang 2 TV",
  "category": "Chuyển nhượng & Chuyển đổi",
  "description": "Bộ hồ sơ chuyển đổi loại hình doanh nghiệp từ Công ty TNHH 1 TV sang Công ty TNHH 2 TV trở lên",
  "has_nganh": true,
  "prepare": "chuyen_doi_1tv_2tv",
  "steps": [
    {
      "id": "company_cu",
      "title": "Công ty TNHH 1 TV hiện tại",
      "fields": [
        {
          "key": "ma_so_thue",
          "label": "Mã số thuế hiện tại",
          "type": "mst_lookup",
          "required": true
        },
        {
          "key": "ten_cong_ty_vn_cu",
          "label": "Tên công ty hiện tại (tiếng Việt)",
          "type": "text",
          "required": true
        },
        {
          "key": "dia_chi_so_nha",
          "label": "Số nhà, tên đường",
          "type": "text",
          "required": true
        },
        {
          "key": "dia_chi_xa_phuong",
          "label": "Xã/Phường",
          "type": "text",
          "required": true
        },
        {
          "key": "dia_chi_tinh_thanh",
          "label": "Tỉnh/Thành phố",
          "type": "text",
          "required": true
        },
        {
          "key": "von_dieu_le_so",
          "label": "Vốn điều lệ (VNĐ)",
          "type": "money",
          "required": true,
          "help": "Chuyển đổi loại hình không thay đổi vốn điều lệ."
        },
        {
          "key": "tinh_dang_ky",
          "label": "Tỉnh/Thành phố nơi đăng ký",
          "type": "select",
          "options_source": "tinh_thanh",
          "default": "Hà Nội",
          "required": true
        }
      ]
    },
    {
      "id": "csh",
      "title": "Chủ sở hữu cũ (bên chuyển nhượng vốn)",
      "fields": [
        {
          "key": "csh",
          "label": "Chủ sở hữu cũ",
          "type": "person",
          "ocr": true,
          "required": true
        }
      ]
    },
    {
      "id": "hinh_thuc",
      "title": "Hình thức chuyển nhượng của chủ sở hữu cũ",
      "fields": [
        {
          "key": "hinh_thuc_cn",
          "label": "Hình thức chuyển nhượng",
          "type": "select",
          "required": true,
          "default": "mot_phan",
          "options": [
            {
              "value": "mot_phan",
              "label": "Chuyển nhượng MỘT PHẦN vốn (chủ sở hữu cũ giữ lại vốn, là Thành viên 1)"
            },
            {
              "value": "toan_bo",
              "label": "Chuyển nhượng TOÀN BỘ vốn (chủ sở hữu cũ rút khỏi công ty)"
            }
          ]
        },
        {
          "key": "csh_von_giu_lai",
          "label": "Số vốn chủ sở hữu cũ giữ lại (VNĐ)",
          "type": "money",
          "required": true,
          "show_if": {
            "field": "hinh_thuc_cn",
            "equals": "mot_phan"
          }
        },
        {
          "key": "csh_ty_le",
          "label": "Tỷ lệ vốn chủ sở hữu cũ giữ lại (%)",
          "type": "percent",
          "required": true,
          "validate": {
            "min": 0,
            "max": 100
          },
          "show_if": {
            "field": "hinh_thuc_cn",
            "equals": "mot_phan"
          }
        }
      ]
    },
    {
      "id": "company_moi",
      "title": "Công ty TNHH 2 TV sau chuyển đổi",
      "fields": [
        {
          "key": "ten_cong_ty_vn",
          "label": "Tên công ty sau chuyển đổi (tiếng Việt)",
          "type": "text",
          "required": false,
          "help": "Để trống nếu giữ nguyên tên hiện tại."
        },
        {
          "key": "ten_cong_ty_nn",
          "label": "Tên tiếng nước ngoài",
          "type": "text"
        },
        {
          "key": "ten_cong_ty_viet_tat",
          "label": "Tên viết tắt",
          "type": "text"
        },
        {
          "key": "sdt_cong_ty",
          "label": "Số điện thoại",
          "type": "phone"
        },
        {
          "key": "email_cong_ty",
          "label": "Email",
          "type": "email"
        }
      ]
    },
    {
      "id": "tv_moi",
      "title": "Thành viên mới (nhận chuyển nhượng từ chủ sở hữu cũ)",
      "fields": [
        {
          "key": "thanh_vien",
          "label": "Thành viên mới",
          "type": "list",
          "min": 1,
          "help": "Mỗi thành viên mới có một Hợp đồng chuyển nhượng + Biên bản thanh lý với chủ sở hữu cũ.",
          "item": [
            {
              "key": "ho_ten",
              "label": "Họ và tên",
              "type": "text",
              "required": true
            },
            {
              "key": "gioi_tinh",
              "label": "Giới tính",
              "type": "select",
              "default": "Nam",
              "options": [
                {
                  "value": "Nam",
                  "label": "Nam"
                },
                {
                  "value": "Nữ",
                  "label": "Nữ"
                }
              ]
            },
            {
              "key": "ngay_sinh",
              "label": "Ngày sinh",
              "type": "date"
            },
            {
              "key": "so_cccd",
              "label": "Số CCCD",
              "type": "cccd"
            },
            {
              "key": "dia_chi_so_nha",
              "label": "Số nhà, đường",
              "type": "text"
            },
            {
              "key": "dia_chi_xa_phuong",
              "label": "Xã/Phường",
              "type": "text"
            },
            {
              "key": "dia_chi_tinh_thanh",
              "label": "Tỉnh/Thành phố",
              "type": "text"
            },
            {
              "key": "von_gop",
              "label": "Số vốn nhận chuyển nhượng (VNĐ)",
              "type": "money",
              "required": true
            },
            {
              "key": "ty_le",
              "label": "Tỷ lệ (%)",
              "type": "number",
              "required": true
            }
          ],
          "auto_ratio": {
            "part": "von_gop",
            "total": "von_dieu_le_so",
            "target": "ty_le"
          }
        }
      ]
    },
    {
      "id": "ddpl",
      "title": "Người đại diện theo pháp luật của công ty sau chuyển đổi",
      "fields": [
        {
          "key": "ddpl",
          "label": "Người đại diện theo pháp luật",
          "type": "person",
          "ocr": true,
          "required": true
        }
      ]
    }
  ],
